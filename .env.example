# ========================================================
# LinkedIn Auto Apply - Environment Configuration Template
# ========================================================
# COPY this file to .env and fill in your real values.
# NEVER commit your actual .env file or credentials to GitHub!
# The .gitignore file automatically excludes .env, .env.*, and user_config.json.

# --- LinkedIn Credentials (Optional if logging in manually in Chrome) ---
LINKEDIN_USERNAME=your_email@example.com
LINKEDIN_PASSWORD=your_secure_password

# --- AI Configuration (Optional: LangChain / OpenAI / Gemini / Ollama) ---
USE_AI=false
AI_PROVIDER=openai # Options: "openai", "gemini", "deepseek"
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here
LLM_API_URL=https://api.openai.com/v1/

# --- Candidate Profile Defaults ---
CANDIDATE_FIRST_NAME=Ankur
CANDIDATE_LAST_NAME=Kumar
CANDIDATE_PHONE=9876543210
CANDIDATE_CITY=Noida
CANDIDATE_STATE=Uttar Pradesh
CANDIDATE_COUNTRY=India

# --- Job Preferences ---
YEARS_OF_EXPERIENCE=2
CURRENT_CTC=1100000
DESIRED_SALARY=1500000
NOTICE_PERIOD_DAYS=30
REQUIRE_VISA_SPONSORSHIP=No
LEGALLY_AUTHORIZED_TO_WORK=Yes
